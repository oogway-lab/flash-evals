{
    "name": "flash-evals-workspace",
    "description": "Compare LLM models on image, text, and audio datasets — structured output, latency, cost, field-level diff against labels, and LLM-as-judge scoring.",
    "license": "AGPL-3.0-only",
    "private": true,
    "author": "Oogway Labs and Flash Evals contributors",
    "homepage": "https://github.com/oogway-lab/flash-evals#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oogway-lab/flash-evals.git"
    },
    "bugs": {
        "url": "https://github.com/oogway-lab/flash-evals/issues"
    },
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "prepare": "husky",
        "dev": "node scripts/dev.mjs",
        "dev:install": "node scripts/install-dev-service.mjs",
        "dev:restart": "systemctl --user restart flash-evals-dev",
        "dev:stop": "systemctl --user stop flash-evals-dev",
        "dev:status": "systemctl --user status flash-evals-dev --no-pager && bun run worker:status",
        "dev:logs": "journalctl --user -u flash-evals-dev -f",
        "dev:backup": "bash scripts/backup-dev.sh",
        "test:dev": "node --test scripts/dev.test.mjs scripts/setup-local.test.mjs scripts/production-audit.test.mjs",
        "setup:local": "node scripts/setup-local.mjs",
        "build": "bun run --filter @flash-evals/api-contract build && bun run --filter @flash-evals/secrets build && bun run --filter @flash-evals/api build && bun run --filter @flash-evals/web build",
        "web:build:cloudflare": "bun run --filter @flash-evals/web build:cloudflare",
        "web:smoke:cloudflare": "node scripts/smoke-cloudflare-worker.mjs",
        "web:preview:cloudflare": "bun run --filter @flash-evals/web preview:cloudflare",
        "typecheck": "bun run --filter @flash-evals/site typecheck && bun run --filter @flash-evals/object-storage typecheck && bun run --filter @flash-evals/api-contract typecheck && bun run --filter @flash-evals/llm-core typecheck && bun run --filter @flash-evals/secrets typecheck && bun run --filter @flash-evals/api typecheck && bun run --filter @flash-evals/web typecheck",
        "test": "bun run --filter @flash-evals/api-contract test && bun run --filter @flash-evals/llm-core test && bun run --filter @flash-evals/secrets test && bun run --filter @flash-evals/site test && bun run --filter @flash-evals/api test && bun run --filter @flash-evals/web test",
        "test:coverage": "bun run --filter @flash-evals/api-contract test:coverage && bun run --filter @flash-evals/llm-core test:coverage && bun run --filter @flash-evals/secrets test:coverage && bun run --filter @flash-evals/site test:coverage && bun run --filter @flash-evals/api test:coverage && bun run --filter @flash-evals/web test:coverage",
        "test:e2e": "playwright test",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:boundaries": "dependency-cruiser --config dependency-cruiser.config.cjs .",
        "quality:dead-code": "knip --dependencies --no-config-hints",
        "quality:duplicates": "jscpd apps packages scripts --config jscpd.config.json",
        "quality:versions": "syncpack lint --dependencies '!@flash-evals/**'",
        "quality:debt": "node scripts/check-technical-debt.mjs",
        "quality:flags": "node scripts/check-feature-flags.mjs",
        "quality": "bun run typecheck && bun run build && bun run test && bun run lint && bun run lint:boundaries && bun run check:client-imports && node scripts/check-design-drift.mjs && bun run quality:dead-code && bun run quality:duplicates && bun run quality:versions && bun run quality:debt && bun run quality:flags && bun run docs:check && bun run docs:env",
        "security": "node scripts/run-security-scans.mjs",
        "docs:check": "node scripts/check-doc-commands.mjs",
        "docs:env": "node scripts/check-env-docs.mjs",
        "docs:api": "typedoc --options typedoc.json",
        "models:refresh-snapshot": "bun run --filter @flash-evals/llm-core build && node scripts/update-model-catalog.mjs",
        "labels:sync": "node scripts/sync-github-labels.mjs",
        "api:dev": "bun run --filter @flash-evals/api dev",
        "api:build": "bun run --filter @flash-evals/api build",
        "api:start": "bun run --filter @flash-evals/api start",
        "api:start:railway": "bun run --filter @flash-evals/api start:railway",
        "worker": "bun run --filter @flash-evals/web worker",
        "worker:status": "bun run --filter @flash-evals/web worker:status",
        "worker:migrate-legacy-queue": "bun run --filter @flash-evals/web worker:migrate-legacy-queue",
        "db:bootstrap-pilot-team": "bun run --filter @flash-evals/web db:bootstrap-pilot-team",
        "api:test": "bun run --filter @flash-evals/api test",
        "api:typecheck": "bun run --filter @flash-evals/api typecheck",
        "check:client-imports": "node scripts/check-client-server-imports.mjs",
        "deploy:check": "scripts/check-split-deployment-readiness.sh",
        "deploy:check:live": "scripts/check-live-split-deployment-readiness.sh",
        "smoke:split-health": "scripts/smoke-split-health.sh",
        "smoke:stt": "node scripts/node-with-supabase-ca.mjs --env-file-if-exists=apps/api/.env scripts/smoke-stt-capabilities.mjs",
        "seed": "bun run --filter @flash-evals/web seed",
        "db:migrate": "bun run --filter @flash-evals/web db:migrate",
        "marketing:build": "node scripts/build-marketing.mjs",
        "smoke:mcp": "bun run --filter @flash-evals/api mcp:smoke"
    },
    "engines": {
        "node": "^22.23.4 || ^24.0.0 || >=26.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@next/eslint-plugin-next": "^16.4.5",
        "@playwright/test": "^1.65.0",
        "@vitest/coverage-v8": "5.1.0",
        "dependency-cruiser": "^18.7.2",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "husky": "^9.1.7",
        "jscpd": "^4.3.0",
        "knip": "^6.44.1",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "railway": "3.16.0",
        "syncpack": "^15.3.3",
        "typedoc": "^0.28.14",
        "typescript-eslint": "^8.72.1"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix"
        ],
        "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
            "prettier --write"
        ]
    },
    "trustedDependencies": [
        "esbuild",
        "sharp",
        "unrs-resolver",
        "workerd"
    ],
    "overrides": {
        "source-map-js": "1.2.2",
        "next>sharp": "0.35.5",
        "undici@<8": "7.30.1",
        "body-parser@>=2 <2.4.0": "2.4.0",
        "hono@>=4 <4.13.11": "4.13.11",
        "ip-address@>=10 <10.7.4": "10.7.4",
        "fast-uri@>=3 <3.1.9": "3.1.9",
        "@astrojs/internal-helpers>js-yaml": "4.3.2",
        "@astrojs/internal-helpers>smol-toml": "1.9.1"
    }
}
