# Cloudflare web runtime.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional server-side API origin. Use Railway's private/internal URL when available.
API_BASE_URL=http://localhost:3001

# PostgreSQL used by local Next.js development. For local dev, match
# apps/api/.env's DATABASE_URL. Deployed Cloudflare Workers use the HYPERDRIVE
# binding configured in Cloudflare and apps/web/wrangler.jsonc; do not put a
# production database URL in this file or wrangler.jsonc.
FLASH_EVALS_WEB_DATABASE_URL=

# Required in production. Must exactly match the Railway API INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=change-me

# Must match the API and Railway worker storage adapter.
FLASH_EVALS_STORAGE_ADAPTER=

# Server-only object storage values. Keep these aligned with apps/api/.env.
# They are read by Next.js server actions and the Railway job worker; never use
# NEXT_PUBLIC_ for the account credentials.
# For the Supabase storage adapter, set these three server-only values in both
# API and web environments instead. Do not use Supabase storage values for R2.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
# SUPABASE_STORAGE_BUCKET=flash-evals-images
# SUPABASE_STORAGE_PREFIX=
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flash-evals-media
R2_STORAGE_PREFIX=
# Local S3-compatible test endpoint only; forbidden in production.
R2_ENDPOINT=

# Clerk browser/server configuration for the web runtime. The publishable key
# is also needed at build time: the CSP allows Clerk's Frontend API host decoded
# from it, and a Cloudflare build fails without it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Must match the API's FLASH_EVALS_TENANCY_MODE and FLASH_EVALS_ALLOWED_EMAIL_DOMAIN
# (apps/api/.env.example) — the web tier makes the same allowed-domain check
# before ever calling the API, so a mismatch rejects (or wrongly admits)
# sign-ins the API would have handled differently. In the internal Oogway Labs
# pilot, set FLASH_EVALS_ALLOWED_EMAIL_DOMAIN=oogwaylabs.com in both environments.
FLASH_EVALS_TENANCY_MODE=
FLASH_EVALS_ALLOWED_EMAIL_DOMAIN=

# Build-time. Exact object-storage origin used by browser PUT uploads, added to
# CSP connect-src. For Supabase use https://<project>.supabase.co. For R2 use
# https://<bucket>.<account-id>.r2.cloudflarestorage.com.
FLASH_EVALS_CSP_STORAGE_ORIGIN=

# Local-only auth bypass: signs every request in as FLASH_EVALS_DEFAULT_USER_ID
# without Clerk. Needs AUTH_DEV=true AND AUTH_DEV_ALLOW_INSECURE=1, plus both
# default IDs; ignored when NODE_ENV=production. `pnpm run dev` sets all four
# for the seeded team. Never enable on a server reachable from a network.
AUTH_DEV=
AUTH_DEV_ALLOW_INSECURE=
FLASH_EVALS_DEFAULT_TEAM_ID=
FLASH_EVALS_DEFAULT_USER_ID=
# Optional: workspace the dev principal opens when no workspace is selected yet.
FLASH_EVALS_DEFAULT_WORKSPACE_ID=

# Model for prompt optimize and schema generation. Keep in sync with
# apps/api/.env. Default: gpt-6-luna.
PROMPT_OPTIMIZER_MODEL=

# Server timing logs. Spans slower than FLASH_EVALS_TIMING_SLOW_MS (default 1000) are
# logged; FLASH_EVALS_TIMING_LOGS=true logs every span, for short debugging windows.
FLASH_EVALS_TIMING_LOGS=
FLASH_EVALS_TIMING_SLOW_MS=

# Optional browser analytics/error tracking. Leave empty for local no-op mode.
NEXT_PUBLIC_FLASH_EVALS_ANALYTICS_KEY=
NEXT_PUBLIC_FLASH_EVALS_ERROR_TRACKING_DSN=
NEXT_PUBLIC_FLASH_EVALS_ANALYTICS_DEBUG=false
NEXT_PUBLIC_FLASH_EVALS_FLAG_ANALYTICS_EVENTS=false
NEXT_PUBLIC_FLASH_EVALS_FLAG_ERROR_TRACKING=false

# Worker-only graceful-drain timeout. The worker also reads DATABASE_URL from
# apps/api/.env. Default: 20000 ms; accepted values are 1000–300000 ms.
FLASH_EVALS_WORKER_DRAIN_TIMEOUT_MS=

# Remote development: private Tailscale UI origin and bind address.
# Direct private-IP example: http://100.x.y.z:3000 and 100.x.y.z.
# Match API_BASE_URL, NEXT_PUBLIC_API_BASE_URL and API public URL to your topology.
FLASH_EVALS_DEV_WEB_ORIGIN=
FLASH_EVALS_DEV_BIND_HOST=
