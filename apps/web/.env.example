# Cloudflare web runtime.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional server-side API origin. Use Railway's private/internal URL when available.
API_BASE_URL=http://localhost:3001

# Required in production. Must exactly match the Railway API INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=change-me

# Clerk browser/server configuration for the web runtime. The publishable key
# is also needed at build time: the CSP allows Clerk's Frontend API host decoded
# from it, and a Cloudflare build fails without it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Must match the API's MOSAIC_TENANCY_MODE and MOSAIC_ALLOWED_EMAIL_DOMAIN
# (apps/api/.env.example) — the web tier makes the same allowed-domain check
# before ever calling the API, so a mismatch rejects (or wrongly admits)
# sign-ins the API would have handled differently. Unused in isolated mode.
MOSAIC_TENANCY_MODE=
MOSAIC_ALLOWED_EMAIL_DOMAIN=

# Build-time. Origin the browser PUTs dataset uploads to, added to the CSP
# connect-src. Set it to the API's SUPABASE_URL (e.g. https://abc.supabase.co);
# when empty the CSP allows any https://*.supabase.co project.
MOSAIC_CSP_STORAGE_ORIGIN=

# Local-only auth bypass: signs every request in as MOSAIC_DEFAULT_USER_ID
# without Clerk. Needs AUTH_DEV=true AND AUTH_DEV_ALLOW_INSECURE=1, plus both
# default IDs; ignored when NODE_ENV=production. `pnpm run dev` sets all four
# for the seeded team. Never enable on a server reachable from a network.
AUTH_DEV=
AUTH_DEV_ALLOW_INSECURE=
MOSAIC_DEFAULT_TEAM_ID=
MOSAIC_DEFAULT_USER_ID=
# Optional: workspace the dev principal opens when no workspace is selected yet.
MOSAIC_DEFAULT_WORKSPACE_ID=

# Model for prompt optimize and schema generation. Keep in sync with
# apps/api/.env. Default: gpt-5.4-mini.
PROMPT_OPTIMIZER_MODEL=

# Server timing logs. Spans slower than MOSAIC_TIMING_SLOW_MS (default 1000) are
# logged; MOSAIC_TIMING_LOGS=true logs every span, for short debugging windows.
MOSAIC_TIMING_LOGS=
MOSAIC_TIMING_SLOW_MS=

# Optional browser analytics/error tracking. Leave empty for local no-op mode.
NEXT_PUBLIC_MOSAIC_ANALYTICS_KEY=
NEXT_PUBLIC_MOSAIC_ERROR_TRACKING_DSN=
NEXT_PUBLIC_MOSAIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_MOSAIC_FLAG_ANALYTICS_EVENTS=false
NEXT_PUBLIC_MOSAIC_FLAG_ERROR_TRACKING=false
