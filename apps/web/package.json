{
    "name": "@mosaic/web",
    "version": "0.0.0",
    "private": true,
    "license": "AGPL-3.0-only",
    "scripts": {
        "dev": "../../scripts/build-packages.mjs && next dev",
        "build": "pnpm --filter @mosaic/object-storage build && pnpm --filter @mosaic/api-contract build && pnpm --filter @mosaic/llm-core build && pnpm --filter @mosaic/secrets build && next build",
        "analyze": "next experimental-analyze",
        "build:cloudflare": "pnpm --filter @mosaic/object-storage build && pnpm --filter @mosaic/api-contract build && pnpm --filter @mosaic/llm-core build && pnpm --filter @mosaic/secrets build && opennextjs-cloudflare build",
        "deploy:cloudflare": "pnpm --filter @mosaic/object-storage build && pnpm --filter @mosaic/api-contract build && pnpm --filter @mosaic/llm-core build && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "preview:cloudflare": "opennextjs-cloudflare preview",
        "start": "next start",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "pnpm --filter @mosaic/object-storage build && pnpm --filter @mosaic/api-contract build && pnpm --filter @mosaic/llm-core build && pnpm --filter @mosaic/secrets build && vitest run",
        "test:coverage": "pnpm --filter @mosaic/object-storage build && pnpm --filter @mosaic/api-contract build && pnpm --filter @mosaic/llm-core build && pnpm --filter @mosaic/secrets build && MOSAIC_COVERAGE_RUN=1 vitest run --coverage",
        "worker": "../../scripts/build-packages.mjs && ../../scripts/node-with-supabase-ca.mjs --env-file-if-exists=../api/.env --env-file-if-exists=.env --import tsx scripts/worker.ts",
        "worker:status": "../../scripts/node-with-supabase-ca.mjs --env-file-if-exists=../api/.env --env-file-if-exists=.env --import tsx scripts/worker-status.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "../../scripts/node-with-supabase-ca.mjs --env-file-if-exists=../api/.env --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
        "db:bootstrap-pilot-team": "../../scripts/node-with-supabase-ca.mjs --env-file-if-exists=../api/.env --import tsx scripts/bootstrap-pilot-team.ts",
        "seed": "../../scripts/node-with-supabase-ca.mjs --env-file-if-exists=../api/.env --env-file-if-exists=.env --import tsx scripts/seed.ts"
    },
    "dependencies": {
        "@ai-sdk/gateway": "^4.0.106",
        "@base-ui/react": "1.8.0",
        "@clerk/nextjs": "^7.9.11",
        "@mosaic/api-contract": "workspace:*",
        "@mosaic/object-storage": "workspace:*",
        "@mosaic/llm-core": "workspace:*",
        "@mosaic/secrets": "workspace:*",
        "@xyflow/react": "^12.12.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.3",
        "geist": "^1.7.2",
        "lucide-react": "^1.52.0",
        "next": "^16.4.0",
        "papaparse": "^5.7.0",
        "pg": "^8.23.1",
        "pg-boss": "^10.1.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.20.9",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.5",
        "@types/papaparse": "^5.3.16",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "ai": "^7.0.130",
        "autoprefixer": "^10.6.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "drizzle-kit": "^0.31.11",
        "jsdom": "^27.3.0",
        "postcss": "^8.5.29",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.8.3",
        "vitest": "^5.0.3",
        "wrangler": "^4.148.0"
    }
}
