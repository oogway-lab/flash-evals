---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import DoubleWidth from "../components/DoubleWidth.astro";
import ModelId from "../components/ModelId.astro";
import { code128B } from "../lib/code128";
import {
    CLONE_COMMAND,
    DOCS_URL,
    MCP_DOCS_URL,
    REPO_URL,
    STT_DOCS_URL,
    installSteps,
    item,
    leaderboard,
    lineItems,
    responses,
} from "../lib/content";

const title = "Flash Evals — reduce AI spend with evaluations";
const description =
    "Find opportunities to reduce AI spend while maintaining task accuracy. Compare models, prompts, and workflows on your own examples, with latency and estimated cost alongside results.";

// Footer barcode: real Code 128, so a scanner reads the domain.
const modules = code128B("flashevals.dev");
let x = 10;
const bars: { x: number; w: number }[] = [];
modules.forEach((width, index) => {
    if (index % 2 === 0) bars.push({ x, w: width });
    x += width;
});
const barcodeWidth = x + 10;

const stampTilts = ["-7deg", "5deg", "-4deg"];
let stampIndex = 0;
---

<Base title={title} description={description}>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
        <a class="wordmark" href="/" aria-label="Flash Evals home">Flash Evals</a>
        <nav aria-label="Primary">
            <a href="#compare" class="keep">See an example</a>
            <a href="#alternatives">Compare tools</a>
            <a href="#self-host" class="keep">Run locally</a>
            <a href={REPO_URL} class="keep">GitHub</a>
            <a href="/sign-in" class="keep">Pilot sign-in</a>
        </nav>
    </header>

    <main id="main" class="roll">
        <!-- Masthead -->
        <section class="seg mast" aria-labelledby="hero-title">
            <span class="ln center brand" style="--i:0"><DoubleWidth text="FLASH EVALS" /></span>
            <span class="ln center soft" style="--i:1">Self-hosted model and prompt evaluation</span>
            <span class="ln center soft" style="--i:2">flashevals.dev · AGPL-3.0-only · early alpha</span>
            <span class="ln stars" style="--i:3" aria-hidden="true"></span>
            <h1 id="hero-title" class="ln" style="--i:5">
                Find cheaper ways to run your AI. Check accuracy first.
            </h1>
            <p class="ln pitch" style="--i:6">
                Test smaller models, prompt changes, and multi-step workflows on
                your own examples. Compare accuracy, latency, and estimated cost
                against what you run today, and inspect the misses before you
                ship.
            </p>

            <div class="ln" style="--i:7">
                <div class="clone">
                    <code><span class="prompt">$ </span>{CLONE_COMMAND.split("/").map((part, i) => (<>{i > 0 && <>/<wbr /></>}{part}</>))}</code>
                    <button class="tab" type="button" data-copy={CLONE_COMMAND}>
                        <Icon name="copy" />
                        <span class="idle">Copy</span>
                        <span class="done">Copied</span>
                    </button>
                </div>
                <div class="next">
                    <a href={DOCS_URL}>Try it locally with sample data <Icon name="arrow" /></a>
                    <a href={REPO_URL}>View the source <Icon name="arrow" /></a>
                </div>
            </div>

            <aside class="note">
                <p><b>Your machine, your keys.</b> Flash Evals is open source and
                    runs locally. Your examples go only to the model providers you
                    choose. Hosted access is currently limited to the pilot.
                </p>
            </aside>
        </section>

        <!-- Subtotal: the leaderboard -->
        <section class="seg" id="compare" aria-labelledby="sub-title">
            <h2 class="sec-title develop" id="sub-title">
                <DoubleWidth text={`Compare · ${item.total} items`} />
                <span class="soft">sample data</span>
            </h2>
            <p class="sec-lede develop">
                In this sample, Model B matches the baseline
                field score at a lower estimated cost and response time. Your
                results will depend on your task and examples; inspect misses and
                failed results before choosing.
            </p>

            <table class="board develop" data-board>
                <caption class="visually-hidden">
                    Illustrative comparison for a 240-item receipt extraction run
                </caption>
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Code</span></th>
                        <th scope="col">Model</th>
                        <th scope="col">Fields</th>
                        <th scope="col">Avg</th>
                        <th scope="col">$/1k</th>
                        <th scope="col"><span class="visually-hidden">Verdict</span></th>
                    </tr>
                </thead>
                <tbody>
                    {
                        leaderboard.map((row) => (
                            <tr>
                                <td>
                                    <span class="code">{row.code}</span>
                                </td>
                                <td class="model">
                                    <ModelId id={row.model} />
                                    {row.failures && (
                                        <span class="fail">
                                            <Icon name="cross" /> {row.failures}
                                        </span>
                                    )}
                                </td>
                                <td data-label="Fields">{row.accuracy}</td>
                                <td data-label="Avg">{row.avgLatency}</td>
                                <td data-label="$/1k">{row.costPer1k}</td>
                                <td class="verdict">
                                    {row.stamp && (
                                        <span
                                            class="stamp"
                                            style={`--tilt:${stampTilts[stampIndex]};--i:${stampIndex++}`}
                                        >
                                            {row.stamp}
                                        </span>
                                    )}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6">
                            3 failed results available for review
                        </td>
                    </tr>
                </tfoot>
            </table>

            <aside class="note">
                <p><b>Read the tradeoffs.</b> Fields shows the average field score; Avg
                    is mean response time; $/1k is estimated cost per 1,000 results.
                    All values here are samples.
                </p>
            </aside>
        </section>

        <!-- One item, three models -->
        <section class="seg run" id="run" aria-labelledby="run-title" data-run>
            <h2 class="sec-title develop" id="run-title">
                <DoubleWidth text={`Item ${item.number} / ${item.total}`} />
                <span class="soft">sample run</span>
            </h2>
            <p class="sec-lede develop">
                Look beyond the aggregate. These responses show
                how each model handled one receipt and where a field differs
                from the expected answer.
            </p>

            <div class="input develop">
                <figure class="photo">
                    <div class="slip" aria-hidden="true">
                        <b>{item.merchant.toUpperCase()}</b>
                        <span class="lead"><span>DATE</span><span class="fill"></span><span>2026-09-14</span></span>
                        <span class="lead"><span>OAT MILK</span><span class="fill"></span><span>3.49</span></span>
                        <span class="lead"><span>SOURDOUGH</span><span class="fill"></span><span>6.20</span></span>
                        <span class="lead"><span>EGGS x12</span><span class="fill"></span><span>5.80</span></span>
                        <span class="lead"><span>COFFEE</span><span class="fill"></span><span>14.99</span></span>
                        <span class="lead"><span>APPLES</span><span class="fill"></span><span>4.12</span></span>
                        <span class="lead"><span>RICE</span><span class="fill"></span><span>3.37</span></span>
                        <span class="lead"><span>TAX</span><span class="fill"></span><span>3.12</span></span>
                        <span class="lead"><b>TOTAL</b><span class="fill"></span><b>41.09</b></span>
                    </div>
                    <figcaption>{item.file}</figcaption>
                </figure>
                <div class="ref">
                    <span class="ln caps soft">Expected fields</span>
                    {
                        item.reference.map((f) => (
                            <span class="lead">
                                <span>{f.name}</span>
                                <span class="fill" />
                                <span>{f.value}</span>
                            </span>
                        ))
                    }
                </div>
            </div>

            <div class="responses-head develop">
                <span class="caps">Sample responses, shown in arrival order</span>
                <button class="replay" type="button" data-replay hidden>
                    <Icon name="replay" /> Replay
                </button>
            </div>

            {
                responses.map((r) => {
                    const correct = r.fields.filter((f) => !f.expected).length;
                    return (
                        <article class="resp" data-latency={r.latencyMs}>
                            <div class="resp-head">
                                <span class="code">{r.code}</span>
                                <span class="model"><ModelId id={r.model} /></span>
                                <span class="elapsed" data-elapsed>
                                    {r.latencyMs} ms
                                </span>
                            </div>
                            <ul class="fields">
                                {r.fields.map((f, i) => (
                                    <li
                                        class:list={["field", { miss: f.expected }]}
                                        style={`--i:${i}`}
                                    >
                                        <Icon
                                            class="mark"
                                            name={f.expected ? "cross" : "tick"}
                                            label={f.expected ? "Mismatch" : "Match"}
                                        />
                                        <span>{f.name}</span>
                                        <span class="got">{f.got}</span>
                                        {f.expected && (
                                            <span class="exp">expected {f.expected}</span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                            <div class="resp-sum" style={`--i:${r.fields.length}`}>
                                <span>
                                    Matches {correct}/{r.fields.length}
                                </span>
                                <span>{(r.latencyMs / 1000).toFixed(2)} s</span>
                                <span>${r.cost} est.</span>
                            </div>
                        </article>
                    );
                })
            }

            <aside class="note right">
                <p><b>See the mismatch.</b> Compare each scored field with the expected
                    value. Here, one response returns the date in the wrong format.
                </p>
            </aside>
        </section>

        <!-- Line items -->
        <section class="seg" aria-labelledby="items-title">
            <h2 class="sec-title develop" id="items-title">
                <DoubleWidth text={`What you can test`} />
                <span class="soft">tools · checks</span>
            </h2>
            <p class="sec-lede develop">Start with your current approach, then test alternatives on the same examples. If a direct swap to a smaller model falls short, try splitting a complex prompt into focused sequential steps. Compare the workflow’s end-task quality, latency, and estimated cost against your baseline to see whether smaller models work for your task.</p>
            <ul class="items">
                {
                    lineItems.map((li) => (
                        <li class="develop">
                            <span class="qty">{li.qty === "1" ? "" : li.qty}</span>
                            <span class="name">{li.item}</span>
                            <span class="what">{li.note}</span>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="seg" aria-labelledby="more-title">
            <h2 class="sec-title develop" id="more-title">
                <DoubleWidth text="More ways to test" />
                <span class="soft">audio · agents</span>
            </h2>
            <p class="sec-lede develop">
                Evaluate transcription settings on audio, or connect an MCP-compatible
                agent to prepare runs and inspect results. Agent evaluation calls can
                incur provider charges.
            </p>
            <div class="next develop">
                <a href={STT_DOCS_URL}>Audio evaluation guide <Icon name="arrow" /></a>
                <a href={MCP_DOCS_URL}>Connect an agent <Icon name="arrow" /></a>
            </div>
        </section>

        <section class="seg" id="alternatives" aria-labelledby="alternatives-title">
            <h2 class="sec-title develop" id="alternatives-title">
                <DoubleWidth text="Choosing a tool" />
                <span class="soft">alternatives</span>
            </h2>
            <p class="sec-lede develop">
                The right tool depends on the decision in front of you. These tools
                overlap: several also compare models, scores, cost, and latency.
                Our view, based on their documentation:
            </p>
            <ul class="items tools">
                <li class="develop">
                    <span class="name"><a href="https://langfuse.com/docs/evaluation/overview">Langfuse</a></span>
                    <span class="what">A broad loop connecting production traces, datasets, evaluation, and experiments. Its <a href="https://langfuse.com/docs/evaluation/experiments/compare-experiments">comparison view</a> includes score, cost, and latency.</span>
                </li>
                <li class="develop">
                    <span class="name"><a href="https://www.braintrust.dev/docs/observe">Braintrust</a></span>
                    <span class="what">A platform for production observability and evaluation, with datasets, experiments, and human or automated scoring.</span>
                </li>
                <li class="develop">
                    <span class="name"><a href="https://www.promptfoo.dev/docs/faq/">Promptfoo</a></span>
                    <span class="what">A local-first evaluation tool for testing prompts across providers, with assertions, CI integration, and red teaming.</span>
                </li>
                <li class="develop ours">
                    <span class="name">Flash Evals</span>
                    <span class="what">An early-alpha, self-hosted workbench for testing lower-cost approaches against the one you run today. Build multi-step workflows, such as a complex prompt split into focused steps on smaller models, and compare end-task quality, latency, and estimated cost with your baseline. You design the steps; savings are not guaranteed.</span>
                </li>
            </ul>
        </section>

        <!-- Self-host -->
        <section class="seg" id="self-host" aria-labelledby="host-title">
            <h2 class="sec-title develop" id="host-title">
                <DoubleWidth text={`Run it locally`} />
                <span class="soft">local development</span>
            </h2>
            <p class="sec-lede develop">
                Start with synthetic examples and saved results on your machine.
                Set up a disposable database, then open localhost:3000. You can
                explore without an account or provider key.
            </p>

            <div class="steps-bar develop">
                <span class="caps soft">Node 24.21.0 · pnpm 12.6.0 · Docker Compose v2</span>
                <button class="tab" type="button" data-copy={installSteps.join("\n")}>
                    <Icon name="copy" />
                    <span class="idle">Copy steps</span>
                    <span class="done">Copied</span>
                </button>
            </div>
            <ol class="steps develop">
                {installSteps.map((s) => <li><code>{s}</code></li>)}
            </ol>
            <div class="warn develop">
                <Icon name="cross" />
                <span>Seeding deletes existing application data. Use a disposable database.</span>
            </div>
            <p class="needs develop soft">
                Add your own provider key for real evaluations. Model calls,
                judges, and prompt tests can incur charges. This alpha setup is
                for local development on a trusted machine.
            </p>
        </section>

        <!-- Totals -->
        <section class="seg totals" aria-labelledby="totals-title">
            <h2 class="visually-hidden" id="totals-title">Local alpha terms</h2>
            <span class="lead develop"><span>License</span><span class="fill"></span><span>AGPL-3.0-only</span></span>
            <span class="lead develop"><span>Setup</span><span class="fill"></span><span>Local development</span></span>
            <span class="lead develop"><span>Model calls</span><span class="fill"></span><span>Your provider keys</span></span>
            <span class="lead develop"><span>Costs</span><span class="fill"></span><span>Provider + hosting</span></span>
            <span class="lead develop"><span>Status</span><span class="fill"></span><span>Early alpha</span></span>
            <span class="lead develop grand"><DoubleWidth text="SOURCE PRICE" /><span class="fill"></span><span>0.00</span></span>

            <svg
                class="barcode develop"
                viewBox={`0 0 ${barcodeWidth} 60`}
                preserveAspectRatio="none"
                role="img"
                aria-label="Barcode encoding flashevals.dev"
            >
                {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="60" fill="currentColor" />)}
            </svg>
            <span class="ln center soft develop">flashevals.dev</span>
            <span class="ln center thanks develop"><DoubleWidth text="THANK YOU" /></span>
            <span class="ln center develop">for checking the results</span>
            <span class="ln center soft develop">Keep the evidence with the decision.</span>
            <span class="end-stripe" aria-hidden="true"></span>
        </section>
    </main>

    <footer class="site-foot">
        <ul>
            <li><a href={REPO_URL}>GitHub</a></li>
            <li><a href={DOCS_URL}>Getting started</a></li>
            <li><a href={`${REPO_URL}/blob/main/CONCEPTS.md`}>Concepts</a></li>
            <li><a href={`${REPO_URL}/blob/main/SECURITY.md`}>Security</a></li>
            <li><a href={`${REPO_URL}/blob/main/LICENSE`}>License</a></li>
        </ul>
        <p>© 2026 Oogway Labs Private Limited. Page examples use synthetic outputs and sample figures; they are not benchmarks.</p>
    </footer>

    <div class="printer" role="region" aria-label="Get Flash Evals">
        <div class="panel">
            <div class="lcd" aria-hidden="true">
                <span class="led"></span>
                <span data-lcd>Local setup · start with a clone</span>
            </div>
            <button class="feed" type="button" data-copy={CLONE_COMMAND}>
                <Icon name="copy" />
                <span class="idle">Copy clone command</span>
                <span class="done">Copied to clipboard</span>
            </button>
            <a class="gh" href={DOCS_URL}>Setup guide</a>
        </div>
    </div>

    <script>
        import "../scripts/site";
    </script>
</Base>
