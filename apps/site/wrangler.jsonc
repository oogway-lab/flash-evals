{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "flash-evals-site",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
    },
    "routes": [
        { "pattern": "flashevals.dev", "custom_domain": true },
        { "pattern": "www.flashevals.dev", "custom_domain": true },
    ],
}
