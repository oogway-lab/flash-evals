  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "description": "Create an eval run and durably enqueue it. The optional idempotencyKey makes retries safe; when supplied, choose it before the first request and reuse it for the same intent. pending_enqueue means publication will be retried automatically.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "datasetId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "fieldConfigs": {
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "kind": {
                    "const": "factual",
                    "type": "string",
                  },
                  "spec": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "matcher": {
                            "const": "exact",
                            "type": "string",
                          },
                        },
                        "required": [
                          "matcher",
                        ],
                        "type": "object",
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "matcher": {
                            "const": "numeric_tolerance",
                            "type": "string",
                          },
                          "relative": {
                            "type": "boolean",
                          },
                          "tolerance": {
                            "minimum": 0,
                            "type": "number",
                          },
                        },
                        "required": [
                          "matcher",
                          "tolerance",
                        ],
                        "type": "object",
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "matcher": {
                            "const": "set_overlap",
                            "type": "string",
                          },
                        },
                        "required": [
                          "matcher",
                        ],
                        "type": "object",
                      },
                    ],
                  },
                },
                "required": [
                  "field",
                  "kind",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "kind": {
                    "const": "generative",
                    "type": "string",
                  },
                  "modelId": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "rubric": {
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "field",
                  "kind",
                  "rubric",
                  "modelId",
                ],
                "type": "object",
              },
            ],
          },
          "type": "array",
        },
        "idempotencyKey": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "judgeConfigId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "judgeModelId": {
          "minLength": 1,
          "type": "string",
        },
        "judgePromptVersionId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "judgeReasoningEffort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
          ],
          "type": "string",
        },
        "judgeRubric": {
          "type": "string",
        },
        "maxTokens": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "modelIds": {
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "pipelineId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "projectId": {
          "description": "Project to operate in.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "promptAssignments": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "modelId": {
                "minLength": 1,
                "type": "string",
              },
              "promptVersionId": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
            },
            "required": [
              "modelId",
              "promptVersionId",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "promptVersionId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "reasoningConfigs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "modelId": {
                "minLength": 1,
                "type": "string",
              },
              "reasoningConfig": {
                "additionalProperties": false,
                "properties": {
                  "effort": {
                    "enum": [
                      "none",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "effort",
                ],
                "type": "object",
              },
            },
            "required": [
              "modelId",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "referenceModel": {
          "type": "string",
        },
        "sourceRunId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
      },
      "required": [
