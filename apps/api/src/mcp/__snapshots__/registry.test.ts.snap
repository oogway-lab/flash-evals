  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "description": "Create a route or append an immutable route version using the canonical routing schema.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": false,
          "properties": {
            "cache": {
              "additionalProperties": false,
              "properties": {
                "mosaicReuse": {
                  "enum": [
                    "allow",
                    "force_fresh",
                  ],
                  "type": "string",
                },
                "providerCaching": {
                  "const": "allow",
                  "type": "string",
                },
              },
              "required": [
                "mosaicReuse",
                "providerCaching",
              ],
              "type": "object",
            },
            "generation": {
              "additionalProperties": false,
              "properties": {
                "maxOutputTokens": {
                  "maximum": 1000000,
                  "minimum": 1,
                  "type": "integer",
                },
                "reasoningEffort": {
                  "enum": [
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                  ],
                  "type": "string",
                },
                "seed": {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer",
                },
                "temperature": {
                  "maximum": 2,
                  "minimum": 0,
                  "type": "number",
                },
                "topP": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number",
                },
              },
              "required": [
                "maxOutputTokens",
              ],
              "type": "object",
            },
            "modelId": {
              "minLength": 1,
              "type": "string",
            },
            "retry": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "maxAttempts": {
                      "maximum": 10,
                      "minimum": 1,
                      "type": "integer",
                    },
                    "owner": {
                      "const": "mosaic",
                      "type": "string",
                    },
                    "retryableErrorClasses": {
                      "items": {
                        "enum": [
                          "rate_limit",
                          "timeout",
                          "overloaded",
                          "upstream_unavailable",
                        ],
                        "type": "string",
                      },
                      "maxItems": 4,
                      "type": "array",
                    },
                    "timeoutMs": {
                      "maximum": 600000,
                      "minimum": 1,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "owner",
                    "maxAttempts",
                    "timeoutMs",
                    "retryableErrorClasses",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "owner": {
                      "const": "gateway",
                      "type": "string",
                    },
                    "timeoutMs": {
                      "maximum": 600000,
                      "minimum": 1,
                      "type": "integer",
                    },
                  },
                  "required": [
                    "owner",
                    "timeoutMs",
                  ],
                  "type": "object",
                },
              ],
            },
            "structuredOutput": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "text",
                      "type": "string",
                    },
                  },
                  "required": [
                    "mode",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "const": "json_schema",
                      "type": "string",
                    },
                    "schemaDigest": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "schemaName": {
                      "minLength": 1,
                      "type": "string",
                    },
                    "strict": {
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "mode",
                    "schemaName",
                    "schemaDigest",
                    "strict",
                  ],
                  "type": "object",
                },
              ],
            },
            "transportConfig": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "transport": {
                      "const": "openai",
                      "type": "string",
                    },
                  },
                  "required": [
                    "transport",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "modelFallback": {
                      "const": "disabled",
                      "type": "string",
                    },
                    "transport": {
                      "const": "gateway",
                      "type": "string",
                    },
                    "upstreamPolicy": {
                      "additionalProperties": false,
                      "properties": {
                        "mode": {
                          "const": "gateway_auto",
                          "type": "string",
                        },
                      },
                      "required": [
                        "mode",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "transport",
                    "upstreamPolicy",
                    "modelFallback",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "requireParameters": {
                      "type": "boolean",
                    },
                    "responseCache": {
                      "enum": [
                        "allow",
                        "disable",
                      ],
                      "type": "string",
                    },
                    "transport": {
                      "const": "openrouter",
                      "type": "string",
                    },
                    "upstreamPolicy": {
                      "oneOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "mode": {
                              "const": "auto",
                              "type": "string",
                            },
                          },
                          "required": [
                            "mode",
                          ],
                          "type": "object",
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "allowFallbacks": {
                              "type": "boolean",
                            },
                            "mode": {
                              "const": "preference",
                              "type": "string",
                            },
                            "order": {
                              "items": {
                                "minLength": 1,
                                "type": "string",
                              },
                              "minItems": 1,
                              "type": "array",
                            },
                          },
                          "required": [
                            "mode",
                            "order",
                            "allowFallbacks",
                          ],
                          "type": "object",
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "mode": {
                              "const": "exact",
                              "type": "string",
                            },
                            "only": {
                              "items": {
                                "minLength": 1,
                                "type": "string",
                              },
                              "minItems": 1,
                              "type": "array",
                            },
                          },
                          "required": [
                            "mode",
                            "only",
                          ],
                          "type": "object",
                        },
                      ],
                    },
                  },
                  "required": [
                    "transport",
                    "upstreamPolicy",
                    "requireParameters",
                    "responseCache",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "transport": {
                      "const": "bifrost",
