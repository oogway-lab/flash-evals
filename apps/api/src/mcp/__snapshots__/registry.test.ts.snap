      "readOnlyHint": true,
    },
    "description": "Read a stable, bounded page of workflow cells, optionally filtered by item, node, status, or review verdict and ordered oldest or newest first. Input text, outputs, review annotations, and scores are included only when requested.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
        },
        "includeInputText": {
          "type": "boolean",
        },
        "includeOutput": {
          "type": "boolean",
        },
        "includeReview": {
          "type": "boolean",
        },
        "includeScores": {
          "type": "boolean",
        },
        "itemId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "nodeKey": {
          "minLength": 1,
          "type": "string",
        },
        "order": {
          "enum": [
            "oldest_first",
            "newest_first",
          ],
          "type": "string",
        },
        "projectId": {
          "description": "Project to operate in.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "reviewVerdict": {
          "enum": [
