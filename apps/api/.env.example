# Railway API runtime. For local Docker Postgres, use:
# DATABASE_URL=postgres://mosaic:mosaic@localhost:54322/mosaic
DATABASE_URL=postgres://user:password@db.example.supabase.co:5432/postgres
PORT=3001

# Public origin of this API, used to mint absolute local-upload URLs the browser
# PUTs to under the local storage adapter (dev). Defaults to http://localhost:<PORT>.
MOSAIC_API_PUBLIC_URL=http://localhost:3001

# Supabase private storage. Keep the bucket private.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
SUPABASE_STORAGE_BUCKET=mosaic-images
SUPABASE_STORAGE_PREFIX=

# Cloudflare R2 private storage. Keep the bucket private. These same server-only
# values are required by apps/web for server actions and the Railway worker.
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mosaic-media
R2_STORAGE_PREFIX=
# R2_ENDPOINT is for disposable local S3-compatible tests only; never set in production.
R2_ENDPOINT=

# Object storage adapter: "supabase", "r2", or "local". Blank means supabase, or local
# when MOSAIC_ALLOW_INSECURE_DEV_DEFAULTS=true. "local" is refused in production
# and writes to local disk (see UPLOAD_DIR in docs/configuration.md). The worker
# reads this too. MOSAIC_IMAGE_STORAGE_ADAPTER is a legacy alias.
MOSAIC_STORAGE_ADAPTER=

# Clerk server configuration (optional with the explicit local-dev opt-in; session verification is on web).
CLERK_SECRET_KEY=sk_test_...
# Tenancy mode: "single-org" (default) or "isolated". single-org: every
# signup from MOSAIC_ALLOWED_EMAIL_DOMAIN joins MOSAIC_DEFAULT_TEAM_ID, with
# full visibility into everything everyone else on that domain has created.
# isolated: any verified email is accepted and each new signup gets its own
# private team automatically — for a public deployment that can't predict
# who's signing up. Use isolated for a public instance; use single-org for
# one company self-hosting as an internal tool.
MOSAIC_TENANCY_MODE=

# Email domain allowed to sign in. In the internal Oogway Labs pilot, set this
# to oogwaylabs.com in both API and web environments; the setting also restricts
# sign-in in isolated tenancy when present. The API refuses to start without it
# in single-org mode unless
# MOSAIC_ALLOW_INSECURE_DEV_DEFAULTS=true (local dev only). Also refuses a
# known public email provider (gmail.com, outlook.com, ...) here unless
# MOSAIC_ALLOW_PUBLIC_EMAIL_DOMAIN=true, since every signup from one would
# share a tenant with strangers. Blank in isolated mode means any verified
# address is allowed.
MOSAIC_ALLOWED_EMAIL_DOMAIN=
MOSAIC_ALLOW_PUBLIC_EMAIL_DOMAIN=
MOSAIC_DEFAULT_TEAM_ID=

# Run limits. MOSAIC_MAX_RUN_CELLS caps items x models (or items x workflow
# nodes) per run; default 10000, maximum 16000. MOSAIC_TEAM_DAILY_SPEND_CAP_USD
# is off when blank; when set, new runs are refused once the team's recorded
# spend on runs started in the last 24 hours reaches it.
MOSAIC_MAX_RUN_CELLS=
MOSAIC_TEAM_DAILY_SPEND_CAP_USD=

# Per-user rate limits, counted per minute in Postgres (api_rate_limits).
# LLM covers prompt optimize/generate-schema/test/validate, judge generation and
# STT probes; RUNS covers run creation, retries and workflow runs, including
# the matching MCP tools. Defaults: 20 and 10. Set 0 to disable a limit.
MOSAIC_RATE_LIMIT_LLM_PER_MINUTE=
MOSAIC_RATE_LIMIT_RUNS_PER_MINUTE=

# Cross-origin and internal API security. The API refuses to start without
# INTERNAL_API_TOKEN; generate one with: openssl rand -base64 32
CORS_ORIGINS=http://localhost:3000,https://your-cloudflare-web-domain.example
INTERNAL_API_TOKEN=change-me

# Local development only. `true` makes local disk the default storage adapter,
# which accepts unauthenticated uploads. `pnpm run dev` sets it for you; never
# set it on a reachable host. Refused when NODE_ENV=production.
MOSAIC_ALLOW_INSECURE_DEV_DEFAULTS=

# Base64-encoded 32-byte AES key for team-managed provider credentials.
# Generate once with: openssl rand -base64 32
# Use the same value for the Railway API and every eval worker process.
MOSAIC_SECRETS_ENC_KEY=

# LLM provider keys used by legacy eval setup/execution. Team-managed Workflow
# credentials are configured through Web/MCP and encrypted in Flash Evals storage.
# Direct OpenAI-compatible modes use OPENAI_API_KEY. Multi-provider Gateway mode
# uses MOSAIC_LLM_PROVIDER=gateway plus AI_GATEWAY_API_KEY, which also enables
# live Gateway model availability and token-pricing metadata when Vercel exposes it.
# Post-transcription LLM steps can use MOSAIC_LLM_PROVIDER=openrouter or bifrost
# with the matching key/base URL while primary STT routes remain capability-gated.
# MOSAIC_LLM_PROVIDER does not select transport for explicit Workflow LLM nodes.
# Those nodes resolve a saved project default or pinned immutable route version;
# the worker uses the captured route snapshot and matching stored credential.
OPENAI_API_KEY=sk-...
AI_GATEWAY_API_KEY=
SONIOX_API_KEY=
# Gemini key for the "Gemini 2.5 Flash audio" STT route (disabled until a
# capability probe enables it).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
BIFROST_API_KEY=
BIFROST_BASE_URL=
# Optional JSON map for verified STT routes after live smoke tests.
# Example: {"vercel:openai/whisper-1":{"status":"available"}}
MOSAIC_STT_CAPABILITY_PROBES=
MOSAIC_LLM_PROVIDER=auto
# Production defaults this off. Enable only after the API and every worker are
# on the same routing-compatible revision.
MOSAIC_WORKFLOW_LLM_WRITES_ENABLED=false
# Set to the worker's supported snapshot contract before enabling writes.
MOSAIC_WORKFLOW_LLM_WORKER_CONTRACT_VERSION=1
MOSAIC_GATEWAY_FALLBACK_MODELS=
MOSAIC_GATEWAY_HTTP_REFERER=
MOSAIC_GATEWAY_APP_TITLE=Flash Evals
# Model used to generate judge rubrics for runs. Set the same value in
# apps/web/.env, which uses it for prompt optimize and schema generation.
# Default: gpt-5.4-mini.
PROMPT_OPTIMIZER_MODEL=

# Eval worker (started by `pnpm run worker`, or by start:railway alongside the
# API). The worker loads this file, then apps/web/.env.
# EVAL_CONCURRENCY: parallel cells per run (default 5 for eval runs, 4 for
# workflow runs; minimum 1).
# RUN_STALE_CLAIM_MS / WORKFLOW_STALE_CLAIM_MS: how long a claimed cell may go
# without finishing before another worker reclaims it (default 900000, minimum
# 60000).
# MOSAIC_API_START_WORKER: set "false" to stop start:railway from spawning the
# worker, e.g. when it runs as its own service.
EVAL_CONCURRENCY=
RUN_STALE_CLAIM_MS=
WORKFLOW_STALE_CLAIM_MS=
MOSAIC_API_START_WORKER=

# Optional observability integrations. Leave empty for local no-op mode.
MOSAIC_ERROR_TRACKING_DSN=
MOSAIC_ANALYTICS_KEY=
MOSAIC_ALERT_WEBHOOK_URL=
MOSAIC_PROFILING_ENABLED=false
MOSAIC_FLAG_ANALYTICS_EVENTS=false
MOSAIC_FLAG_ERROR_TRACKING=false
MOSAIC_FLAG_PROFILING=false

# MCP eval server. Deployed MCP uses Clerk OAuth; raw token fallback is local/dev only.
MOSAIC_MCP_ENABLED=false
MOSAIC_MCP_ALLOWED_ORIGINS=
MOSAIC_MCP_RESOURCE_URL=
MOSAIC_MCP_OAUTH_CLIENT_ID=
MOSAIC_MCP_OAUTH_DYNAMIC_CLIENTS=false
MOSAIC_MCP_RAW_TOKEN_FALLBACK_ENABLED=false
MOSAIC_MCP_TOKEN_PEPPER=
CLERK_ISSUER=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
