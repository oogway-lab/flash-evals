{
    "name": "@flash-evals/llm-core",
    "version": "0.0.0",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./transcript-identity": {
            "types": "./src/providers/transcriptIdentity.ts",
            "import": "./dist/providers/transcriptIdentity.js",
            "require": "./dist/providers/transcriptIdentity.js",
            "default": "./dist/providers/transcriptIdentity.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ai-sdk/gateway": "^4.0.123",
        "@ai-sdk/openai": "^4.0.101",
        "ai": "^7.0.150",
        "openai": "^7.43.0",
        "undici": "8.12.3"
    },
    "devDependencies": {
        "typescript": "^5.8.3",
        "vitest": "^5.0.3"
    }
}
