{
    "name": "@flash-evals/api-contract",
    "version": "0.0.0",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./rule-patterns": {
            "types": "./src/rulePatterns.ts",
            "import": "./dist/rulePatterns.js",
            "require": "./dist/rulePatterns.js",
            "default": "./dist/rulePatterns.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "re2js": "2.9.0"
    }
}
